# Development diagnostics. Keep false for production builds.
NEXT_PUBLIC_JOURNEY_DEBUG=false

# Set only after the production domain is approved. When empty, canonical
# metadata is omitted and the sitemap remains empty.
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_SITE_INDEXING=false

# Production gate: set true only after a working public contact route has been
# verified (form/email destination, privacy consent, success and error states).
NEXT_PUBLIC_CONTACT_READY=false

# Optional: absolute ffprobe executable used by npm run asset:check.
FFPROBE_PATH=
